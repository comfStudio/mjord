{
  "extends": ["expo/tsconfig.base", "@mjord/tsconfig/base"],
  "compilerOptions": {
    "baseUrl": ".",

    "experimentalDecorators": true,

    "paths": {
      "@app/*": ["./src/*"],
      "@/feature/*": ["./src/feature/*"],
      "@/components/*": ["./src/components/*"],
      "@/services": ["./src/services/index"],
      "@/services/*": ["./src/services/*"],
      "@/state": ["./src/state/index"],
      "@/state/*": ["./src/state/*"],
      "@/styles": ["./src/styles/index"],
      "@/styles/*": ["./src/styles/*"],
      "@mjord/common/*": ["../../packages/common/lib/*"],
      "@tests/*": ["./src/__tests__/*"]
    }
  },
  "include": ["**/*.ts", "**/*.json", "**/*.tsx", "./types.d.ts", "../../packages/common/types.d.ts", "jest.config.js"],
  "exclude": ["dist", "build", "node_modules", "lib", ".expo"]
}
