{
  "extends": ["expo/tsconfig.base", "@mjord/tsconfig/base"],
  "compilerOptions": {
    "baseUrl": ".",

    "experimentalDecorators": true,

    "paths": {
      "@app/*": ["./*"],
      "@/feature/*": ["./feature/*"],
      "@/components/*": ["./components/*"],
      "@/services": ["./services/index"],
      "@/services/*": ["./services/*"],
      "@/state": ["./state/index"],
      "@/state/*": ["./state/*"],
      "@/styles": ["./styles/index"],
      "@/styles/*": ["./styles/*"],
      "@mjord/common/*": ["../../packages/common/lib/*"],
      "@tests/*": ["./__tests__/*"]
    }
  },
  "include": ["**/*.ts", "**/*.json", "**/*.tsx", "./types.d.ts", "../../packages/common/types.d.ts", "jest.config.js"],
  "exclude": ["dist", "build", "node_modules", "lib", ".expo"]
}
