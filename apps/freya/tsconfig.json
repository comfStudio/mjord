{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@app/*": ["./*"],
      "@/feature/*": ["./feature/*"],
      "@/components/*": ["./components/*"],
      "@/services": ["./services/index"],
      "@/services/*": ["./services/*"],
      "@/state": ["./state/index"],
      "@/state/*": ["./state/*"],
      "@/styles": ["./styles/index"],
      "@/styles/*": ["./styles/*"],
      "@mjord/common/*": ["../../packages/common/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.json",
    "**/*.tsx",
    "./types.d.ts",
    "../../packages/common/types.d.ts"
  ],
  "exclude": ["dist", "build", "node_modules", "lib", ".expo"]
}
