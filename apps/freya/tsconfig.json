{
  "extends": "expo/tsconfig.base",
  "baseUrl": ".",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false
  },
  "references": [{ "path": "../../packages/common" }],
  "include": ["./**/*", "../../packages/common/types.d.ts"],
  "exclude": ["dist", "build", "node_modules", "lib", ".expo"],
  "paths": {
    "@/feature/*": ["feature/*"],
    "@/components/*": ["components/*"],
    "@/services": ["services/index"],
    "@/services/*": ["services/*"],
    "@/state": ["state/index"],
    "@/state/*": ["state/*"],
    "constants": ["constants"]
  }
}
