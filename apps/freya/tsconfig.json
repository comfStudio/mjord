{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "references": [{ "path": "../../packages/common" }],
  "include": [
    "**/*.ts",
    "**/*.json",
    "**/*.tsx",
    "../../packages/common/types.d.ts"
  ],
  "exclude": ["dist", "build", "node_modules", "lib", ".expo"],
  "paths": {
    "@/feature/*": ["./feature/*"],
    "@/components/*": ["./components/*"],
    "@/services": ["./services/index"],
    "@/services/*": ["./services/*"],
    "@/state": ["./state/index"],
    "@/state/*": ["./state/*"],
    "constants": ["./constants"]
  }
}
