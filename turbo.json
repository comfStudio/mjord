{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", "lib/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "outputLogs": "full",
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "lint:prettier": {
      "cache": false
    },
    "start:app": {
      "persistent": true
    },
    "log:edge": {
      "persistent": true,
      "cache": false
    }
  }
}
