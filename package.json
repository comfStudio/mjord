{
  "private": true,
  "name": "mjord",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build --no-daemon --log-order=grouped",
    "dev": "turbo run dev --no-cache --continue --no-daemon --log-order=grouped",
    "lint": "turbo run lint --no-cache --continue --no-daemon",
    "lint:prettier": "turbo run lint:prettier --no-cache --continue --no-daemon",
    "test": "turbo run test --no-daemon",
    "clean": "turbo run clean  --no-daemon",
    "run:app": "yarn workspace @mjord/freya",
    "add:app": "yarn workspace @mjord/freya add",
    "remove:app": "yarn workspace @mjord/freya remove",
    "start:app": "yarn workspace @mjord/freya start",
    "run:backend": "yarn workspace @mjord/backend",
    "add:backend": "yarn workspace @mjord/backend add",
    "remove:backend": "yarn workspace @mjord/backend remove",
    "start:backend": "yarn workspace @mjord/backend dev",
    "run:edge": "yarn workspace @mjord/edge",
    "bin:supabase": "./node_modules/supabase/bin/supabase"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "config/*"
  ],
  "packageManager": "yarn@3.5.0",
  "devDependencies": {
    "babel-plugin-ttag": "^1.8.9",
    "dotenv-cli": "^7.1.0",
    "eslint": "^8.50.0",
    "hotscript": "^1.0.13",
    "prettier": "^3.0.3",
    "rimraf": "^4.4.1",
    "supabase": "^1.86.2",
    "tsc": "^2.0.4",
    "ttag-cli": "^1.10.5",
    "turbo": "1.13.*",
    "typescript": "^5.2.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@mjord/custom/base"
    ],
    "ignorePatterns": [
      "node_modules",
      ".yarn",
      "services/edge",
      "./config"
    ]
  }
}
