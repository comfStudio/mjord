{
  "private": true,
  "name": "mjord",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build --no-daemon",
    "dev": "turbo run dev --no-cache --continue --no-daemon",
    "test": "turbo run test --no-daemon",
    "clean": "turbo run clean  --no-daemon",
    "run:app": "yarn workspace @mjord/freya",
    "add:app": "yarn workspace @mjord/freya add",
    "remove:app": "yarn workspace @mjord/freya remove",
    "start:app": "yarn workspace @mjord/freya start",
    "run:backend": "yarn workspace @mjord/backend",
    "add:backend": "yarn workspace @mjord/backend add",
    "remove:backend": "yarn workspace @mjord/backend remove",
    "start:backend": "yarn workspace @mjord/backend dev",
    "run:edge": "yarn workspace @mjord/edge",
    "bin:supabase": "./node_modules/supabase/bin/supabase"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "config/*"
  ],
  "packageManager": "yarn@3.5.0",
  "devDependencies": {
    "babel-plugin-ttag": "https://github.com/iSplasher/babel-plugin-ttag#commit=0ce9f02410d851b8a8450eeaf767e025a1b9dfef",
    "dotenv-cli": "^7.1.0",
    "rimraf": "^4.4.1",
    "supabase": "^1.86.2",
    "tsc": "^2.0.4",
    "ttag-cli": "^1.10.5",
    "turbo": "1.10.13",
    "typescript": "^5.2.2"
  }
}
