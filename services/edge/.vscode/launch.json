{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Debug all tests",
      "type": "node",
      // "program": "${workspaceFolder}/main.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "test",
        "tests/**/*.test.ts",
        "--unstable",
        "--import-map",
        "./services/edge/src/import_map.json",
        "--inspect-brk",
        "--trace-ops",
        "--allow-all"
      ],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Debug test",
      "type": "node",
      // "program": "${workspaceFolder}/main.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "test",
        "${file}",
        "--unstable",
        "--import-map",
        "./src/import_map.json",
        "--inspect-brk",
        "--trace-ops",
        "--allow-all"
      ],
      "attachSimplePort": 9229
    }
  ]
}
