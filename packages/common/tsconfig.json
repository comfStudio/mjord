{
  "compilerOptions": {
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "src",
    "composite": true,
    "target": "es2018",
    "declaration": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true,
    "jsx": "react-jsx",
    "strict": true,
    "declarationMap": true
  },
  "include": ["./src/**/*", "types.d.ts"],
  "exclude": ["dist", "build", "node_modules", "lib"]
}
